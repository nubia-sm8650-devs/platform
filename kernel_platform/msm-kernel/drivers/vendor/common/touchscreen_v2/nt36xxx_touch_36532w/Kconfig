#	  to your system by SPI bus.
#
#	  If unsure, say N.

menuconfig TOUCHSCREEN_NT36XXX_TOUCH_36532W
	tristate "Novatek NT36xxx host touchscreen"
	help
	  Say Y here if you have a Novatek NT36xxx no flash touchscreen connected
	  to your system by SPI bus.
	  
	  If build module, say M.
	  If unsure, say N.
