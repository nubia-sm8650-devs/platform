ifeq ($(CONFIG_ARCH_KALAMA),y)
dtbo-y += kalama-bt.dtbo
endif

ifeq ($(CONFIG_ARCH_PINEAPPLE),y)
  ifneq (,$(filter qvanise panax,$(ZTE_BOARD_NAME)))
    $(warning "enter into pineapple hdk bt PQ83P01/P02 dtsi")
    dtbo-y += pineapple-hdk-kiwi-bt-zte.dtbo
  else
    dtbo-y += pineapple-kiwi-bt.dtbo
    dtbo-y += pineapple-hdk-kiwi-bt.dtbo
  endif
endif

ifeq ($(CONFIG_ARCH_WAIPIO),y)
dtbo-y += waipio-bt.dtbo
dtbo-y += waipio-kiwi-bt.dtbo
endif

ifeq ($(CONFIG_ARCH_BLAIR),y)
dtbo-y += blair-bt.dtbo
endif

always-y        := $(dtb-y) $(dtbo-y)
subdir-y        := $(dts-dirs)
clean-files     := *.dtb *.dtbo
